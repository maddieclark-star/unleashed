# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Dependencies (no build step, but just in case anything installs locally)
node_modules/

# Logs
npm-debug.log*
*.log

# Full-resolution source photos — kept out of the repo, see assets/originals/
assets/originals/

# Claude Code worktrees live inside .claude/ — never commit them into the repo.
.claude/worktrees/

# Per-worktree scope instructions. Each worktree owns one section and this file
# says which. Local to the checkout, so it never conflicts on merge.
CLAUDE.local.md

# Per-worktree run config — each worktree needs its own port, so this
# must not be shared. Keep a local copy per checkout.
.claude/launch.json

# Scratch files. Kept on disk, never deployed — _button-lab.html would
# otherwise be reachable at /_button-lab.html on the live site, and
# ParallaxHero.tsx is a React reference file in a no-React project.
_button-lab.html
ParallaxHero.tsx

# Working screenshots dropped into assets/ while building.
assets/shot*.png
